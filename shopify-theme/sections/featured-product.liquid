{%- liquid
  assign product = section.settings.product
-%}

<section class="section">
  <div class="page-width">
    {%- if product != blank -%}
      <div class="image-with-text">
        <div class="image-with-text__media">
          {%- if product.featured_media != blank -%}
            <img src="{{ product.featured_media | image_url: width: 1000 }}" alt="{{ product.featured_media.alt | escape }}" loading="lazy">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <div class="image-with-text__content">
          {%- if section.settings.heading != blank -%}
            <h2>{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          <div class="price">{{ product.price | money }}</div>
          {%- if section.settings.text != blank -%}
            <p>{{ section.settings.text | escape }}</p>
          {%- endif -%}
          <a href="{{ product.url }}" class="btn">{{ section.settings.button_label | default: 'View product' | escape }}</a>
        </div>
      </div>
    {%- else -%}
      <div class="rich-text">
        <p>Select a product in the theme editor to feature it here.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Spiral Tee" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Hand screen-printed on heavyweight organic cotton. Limited quantities — once it's gone, it's gone." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
