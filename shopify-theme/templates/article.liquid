<section class="section">
  <div class="page-width" style="max-width:760px;">
    <h1>{{ article.title }}</h1>
    <p style="opacity:0.6;">{{ article.published_at | date: '%B %d, %Y' }}</p>
    {%- if article.image -%}
      <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.title | escape }}">
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</section>
