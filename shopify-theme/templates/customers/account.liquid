<section class="section">
  <div class="page-width" style="max-width:760px;">
    <h1>{{ 'customer.account.title' | t }}</h1>
    <p><a href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a> &middot;
       <a href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t }}</a></p>

    <h2>{{ 'customer.orders.title' | t }}</h2>
    {%- if customer.orders.size > 0 -%}
      <ul style="list-style:none;padding:0;">
        {%- for order in customer.orders -%}
          <li style="padding:1rem 0;border-bottom:1px solid var(--color-border);">
            <a href="{{ order.customer_url }}"><strong>{{ order.name }}</strong></a> —
            {{ order.created_at | date: '%B %d, %Y' }} — {{ order.total_net_amount | money }} —
            {{ order.financial_status_label }}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p>{{ 'customer.orders.none' | t }}</p>
    {%- endif -%}
  </div>
</section>
