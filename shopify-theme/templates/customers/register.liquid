<section class="section">
  <div class="page-width" style="max-width:440px;">
    <h1 class="section__title">{{ 'customer.register.title' | t }}</h1>

    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <div class="form__message form__message--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label for="first">{{ 'customer.register.first_name' | t }}</label>
      <input type="text" name="customer[first_name]" id="first" autocomplete="given-name">
      <label for="last">{{ 'customer.register.last_name' | t }}</label>
      <input type="text" name="customer[last_name]" id="last" autocomplete="family-name">
      <label for="email">{{ 'customer.register.email' | t }}</label>
      <input type="email" name="customer[email]" id="email" autocomplete="email">
      <label for="password">{{ 'customer.register.password' | t }}</label>
      <input type="password" name="customer[password]" id="password" autocomplete="new-password">
      <button type="submit" class="btn btn--full">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}

    <p style="margin-top:1.5rem;text-align:center;">
      <a href="{{ routes.account_login_url }}">{{ 'customer.register.sign_in' | t }}</a>
    </p>
  </div>
</section>
