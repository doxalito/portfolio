<section class="section">
  <div class="page-width">
    <h1 class="section__title">{{ 'general.search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:520px;margin:0 auto 2rem;">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.placeholder' | t }}">
      <button type="submit" class="btn btn--full">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      <div class="features">
        {%- for item in search.results -%}
          <a href="{{ item.url }}" class="feature">
            {%- if item.featured_media -%}
              <img src="{{ item.featured_media | image_url: width: 600 }}" alt="{{ item.title | escape }}" loading="lazy">
            {%- endif -%}
            <h3>{{ item.title }}</h3>
          </a>
        {%- else -%}
          <p>{{ 'general.search.no_results' | t }}</p>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
